# music-stack settings
# Copy this file to settings.env next to the setup script and edit.
# Plain KEY=VALUE lines. Empty values fall back to per-platform defaults.

# The shared library folder (Lidarr root folder == Navidrome MusicFolder).
# This is the ONLY path both services care about. Defaults:
#   Windows: C:\Music        macOS: ~/Music        Pi: /mnt/music
MUSIC_DIR=

# Where app databases/config live. Defaults:
#   Windows: C:\ProgramData\music-stack
#   macOS:   ~/Library/Application Support/music-stack
#   Pi:      /var/lib/music-stack
DATA_DIR=

# qBittorrent's save/download folder (defaults to <DATA_DIR>/downloads)
DOWNLOAD_DIR=

# Ports (defaults shown)
NAVIDROME_PORT=4533
LIDARR_PORT=8686
QBIT_PORT=8080

# qBittorrent WebUI credentials. Lidarr talks to it using these, and the
# scripts pre-seed qBittorrent's config so the WebUI accepts them.
# CHANGE THIS. qBittorrent's own default is admin/adminadmin which is a
# well-known hole; the scripts do not ship a default password.
QBIT_USER=admin
QBIT_PASSWORD=

# Lidarr API key. Leave empty to auto-generate a random one.
LIDARR_API_KEY=

# Navidrome rescan schedule in Cron syntax (e.g. "@every 12h").
# Empty = rely on the built-in file watcher only.
NAVIDROME_SCAN_SCHEDULE=
